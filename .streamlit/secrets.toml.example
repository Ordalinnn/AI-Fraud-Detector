# Copy this file to .streamlit/secrets.toml (which is gitignored — never
# commit your real key) to enable the optional "Deep AI Analysis" feature.
#
# Get a key at https://console.anthropic.com/settings/keys
#
# On Streamlit Community Cloud, don't upload this file at all — instead
# set ANTHROPIC_API_KEY under your app's Settings -> Secrets in the
# dashboard, using the same TOML format shown below.
#
# Without this configured, the rest of the app works exactly the same —
# deep analysis just shows a message explaining it isn't set up yet.

ANTHROPIC_API_KEY = "sk-ant-..."
