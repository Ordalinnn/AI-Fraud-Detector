{
  "manifest_version": 3,
  "name": "AI Fraud Detector",
  "short_name": "FraudDetector",
  "description": "Checks selected text or pasted messages for scam/fraud indicators, entirely on your device — nothing is sent to a server.",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "notifications", "storage"]
}
